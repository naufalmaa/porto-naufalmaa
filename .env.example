# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to `.env` or `.env.local` for local development.
# In Vercel, enter these values under Project Settings -> Environment Variables.
# Do NOT commit your actual .env file to version control.

# ------------------------------------------------------------------------------
# 1. SITE CONFIGURATION
# ------------------------------------------------------------------------------
# Public canonical URL of your production website (used for metadata, SEO, and Auth callbacks)
# Example production: https://your-portfolio.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Prisma ORM + Neon PostgreSQL)
# ------------------------------------------------------------------------------
# PostgreSQL connection string from Neon Console (https://console.neon.tech).
# Always include "?sslmode=require" for Neon serverless PostgreSQL connections.
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/dbname?sslmode=require"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION (NextAuth.js v5 Beta)
# ------------------------------------------------------------------------------
# Cryptographic secret used to sign cookies and JWT tokens.
# Generate a secure 32-byte secret using: `openssl rand -base64 32` or `npx auth secret`
AUTH_SECRET=""

# GitHub OAuth App ID & Secret
# Create a GitHub OAuth Application: https://github.com/settings/applications/new
# Homepage URL: http://localhost:3000 (or production URL)
# Callback URL: http://localhost:3000/api/auth/callback/github (or production callback URL)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Optional aliases if using NextAuth default variable names:
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 4. ADMIN RESTRICTIONS
# ------------------------------------------------------------------------------
# The exact email address of your GitHub account authorized to access /admin routes
ADMIN_GITHUB_EMAIL="your_github_email@example.com"
